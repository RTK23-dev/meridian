# Copy to .env and fill only the values you have.
# Meridian stays not-connected for anything left blank. It does not invent ads, clips, or metrics.
# Never commit .env.

# Required for a durable database. See docs/SETUP.md for the local Postgres options.
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/meridian

# Public origin used for auth cookies and invite links.
BETTER_AUTH_URL=http://127.0.0.1:8080
BETTER_AUTH_SECRET=

# JEV Typed Decision Layer: direct TypeSafe, OpenRouter Decisions, auto fallback, or compare mode.
# Canonical names (MERIDIAN_JEV_*, TYPESAFE_JEV_*, OPENROUTER_JEV_*).
# Modes: auto, typesafe_direct, openrouter, compare.
MERIDIAN_JEV_PROVIDER_MODE=auto
MERIDIAN_JEV_PREFERRED_PROVIDER=typesafe_direct
MERIDIAN_JEV_FALLBACK_ENABLED=true
MERIDIAN_JEV_TIMEOUT_MS=30000
MERIDIAN_JEV_COMPARE_SAMPLE_RATE=0.1

# Direct TypeSafe AI JEV (System One Endpoint)
TYPESAFE_JEV_API_KEY=
TYPESAFE_JEV_BASE_URL=https://api.typesafe.ai/v1/systemone
TYPESAFE_JEV_MODEL=typesafe/jev-1.13

# OpenRouter Decisions JEV API
OPENROUTER_JEV_API_KEY=
OPENROUTER_JEV_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_JEV_MODEL=typesafe/jev-1.13

# (Legacy aliases supported for backward compatibility:
# JEV_PROVIDER_MODE, TYPESAFE_API_KEY, TYPESAFE_BASE_URL, TYPESAFE_MODEL,
# OPENROUTER_API_KEY, JEV_BASE_URL, JEV_MODEL)

# Google Gemini Models (Gemini Interactions API & Multimodal Perception)
# Primary video generation & editing: gemini-omni-1.1-flash
# Primary image generation & editing: gemini-nano-banana-2.1
MERIDIAN_GEMINI_API_KEY=
MERIDIAN_GEMINI_OMNI_MODEL=gemini-omni-1.1-flash
MERIDIAN_IMAGE_MODEL=gemini-nano-banana-2.1
# Documented aliases: GOOGLE_AI_STUDIO_API_KEY, GEMINI_API_KEY, GOOGLE_API_KEY, GOOGLE_NANO_BANANA_MODEL

# Cyclone Scout Observation Gateway & MCP
# Connects to real Cyclone device gateway (read-only scout observation without mutations).
CYCLONE_GATEWAY_URL=http://127.0.0.1:4000
CYCLONE_API_KEY=
CYCLONE_DEVICE_ID=
CYCLONE_SESSION_ID=
CYCLONE_OBSERVATION_BUDGET=20

# Production Routing Preference: ZERO_SPEND, LOWEST_COST, BALANCED, QUALITY_FIRST
PRODUCTION_COST_PREFERENCE=BALANCED

# Separate Hypit process. Studio video stays HYPIT_NOT_CONNECTED until this answers.
# Install Hypit yourself. Do not copy its source into this repository.
HYPIT_BASE_URL=
HYPIT_API_TOKEN=
HYPIT_BIN=

# Optional external embeddings. Local MiniLM is used when these are blank.
EXTERNAL_SEMANTIC_URL=
EXTERNAL_SEMANTIC_KEY=
EXTERNAL_SEMANTIC_MODEL=
EXTERNAL_SEMANTIC_DIMENSIONS=

# Invite email. Without both, invitations are stored and not sent.
EMAIL_API_URL=
EMAIL_API_KEY=

# Object storage. Without these, files stay on the filesystem provider.
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=

# Token storage and webhooks. Required before OAuth tokens or webhook posts are accepted.
TOKEN_ENCRYPTION_KEY=
WEBHOOK_SECRET=

# Meta
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=
META_APP_ID=
META_APP_SECRET=
META_AD_LIBRARY_TOKEN=

# JEV Research: Meta Ad Library source, OpenRouter analysis, and local WhisperX/ffmpeg runtime.
WHISPERX_PATH=whisperx
WHISPERX_MODEL=small
WHISPERX_DEVICE=cpu
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

# TikTok
TIKTOK_ACCESS_TOKEN=
TIKTOK_ADVERTISER_ID=
TIKTOK_APP_ID=
TIKTOK_APP_SECRET=

# Google Ads
GOOGLE_ADS_ACCESS_TOKEN=
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
