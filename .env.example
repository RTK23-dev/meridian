# Copied to .env by `npm run setup`. Fill only what you have. Anything blank stays not-connected.
# Meridian never invents ads, clips, metrics or connected states. Never commit .env.
#
# Each variable is listed once. The comment above it says what it is:
#   infrastructure           set on the server only (database, secrets, object storage, email)
#   deployment configuration a setting for the deployment, or an opt-in such as a *_SHARED_DEFAULT
#   per-workspace key        saved by an admin in Settings, General, Setup, encrypted, never shown again
#   developer tooling        read by scripts and tests only; the app does not need it
#
# A per-workspace key's deployment fallback is used only when its *_SHARED_DEFAULT variable is set to the value its comment names.

# =============================================================================
# Needed to start
#
# Nothing in this part is required. npm run setup fills the two secrets. A blank DATABASE_URL keeps the
# database on disk in .data/pglite. npm run dev sets that folder, and runs the queued jobs too. Outside NODE_ENV=development or test,
# a blank DATABASE_URL is refused: the app does not start.
# =============================================================================

# infrastructure: signs sessions. `npm run setup` generates it when it is blank. Blank on a server uses a per-process secret, so sign-in ends on restart.
BETTER_AUTH_SECRET=
# infrastructure: encrypts saved keys and OAuth tokens. `npm run setup` generates it when it is blank.
TOKEN_ENCRYPTION_KEY=
# infrastructure: Postgres URL. Blank uses the embedded PGlite database: on disk in .data/pglite under npm run dev, in memory otherwise.
DATABASE_URL=
# infrastructure: the folder that keeps the embedded database on disk. npm run dev sets it to .data/pglite when DATABASE_URL is blank. Blank keeps the database in memory.
MERIDIAN_LOCAL_DATA_DIR=
# deployment configuration: public origin for sign-in cookies and invite links.
BETTER_AUTH_URL=http://127.0.0.1:8080
# deployment configuration: "false" turns sign-in off for local use only. Unset keeps it on.
VITE_AUTH_ENABLED=

# =============================================================================
# Needed for a real deployment
#
# A deployment needs DATABASE_URL, BETTER_AUTH_URL, BETTER_AUTH_SECRET, TOKEN_ENCRYPTION_KEY and NODE_ENV=production.
# The first four are in the part above, because a local start reads them too. The rest of this part is optional:
# a blank value leaves that feature not connected.
# =============================================================================

# deployment configuration: exact public origins allowed for OAuth redirects, comma-separated. Required outside localhost.
MERIDIAN_ALLOWED_OAUTH_ORIGINS=
# deployment configuration: set true only when every direct request is behind a trusted reverse proxy that overwrites these headers.
MERIDIAN_TRUST_PROXY_HEADERS=false
# deployment configuration: comma-separated domains that provider artifacts may be downloaded from (subdomains included). Blank allows any public https host.
MERIDIAN_ARTIFACT_HOST_ALLOWLIST=
# deployment configuration: public origin of this deployment, used for OAuth redirects. Leave blank locally.
APP_URL=
# deployment configuration: optional second public origin. Leave blank unless the app is also served from another origin.
PUBLIC_APP_URL=
# infrastructure: signs the short-lived links Instagram and TikTok fetch an approved video through. At least 32 random characters. Blank leaves those two platforms not connected. Never commit a real value.
MEDIA_LINK_SECRET=
# deployment configuration: comma-separated hostnames that TikTok has verified for this app (for example media.example.com). Subdomains are covered. TikTok pulls videos only from these hosts, so blank leaves TikTok not connected.
TIKTOK_VERIFIED_MEDIA_DOMAINS=

# deployment configuration: extra origins that may sign in, comma-separated (for example https://staging.example.com). The origin in BETTER_AUTH_URL and the origin a request came from are trusted already.
MERIDIAN_TRUSTED_ORIGINS=
# infrastructure: signs webhook posts. Webhooks are refused until it is set.
WEBHOOK_SECRET=
# deployment configuration: set by the runtime (production when deployed). Leave it unset locally.
# NODE_ENV=development
# deployment configuration: "true" runs the testing runtime with fixtures and no real providers. Never set it in production.
MERIDIAN_TESTING_RUNTIME=
# deployment configuration: "true" allows synthetic telemetry outside production. Test use only.
ALLOW_SYNTHETIC_TELEMETRY=
# deployment configuration: the decision engine for workspaces without their own choice. Values: jev, openai-decisions.
DECISION_ENGINE=jev
# deployment configuration: the default cost preference when a workspace has none: ZERO_SPEND, LOWEST_COST, BALANCED or QUALITY_FIRST.
PRODUCTION_COST_PREFERENCE=BALANCED
# infrastructure: invitation email. Without both, invitations are stored and not sent.
EMAIL_API_URL=
# infrastructure: the email API key.
EMAIL_API_KEY=

# Google Drive is configured on the deployment and shared by every workspace. Set one of the two credential sets.
# deployment configuration: a Google service account key (JSON), or the OAuth client below.
GOOGLE_SERVICE_ACCOUNT_KEY=
# deployment configuration: OAuth client id for Google Drive.
GOOGLE_CLIENT_ID=
# infrastructure: OAuth client secret for Google Drive.
GOOGLE_CLIENT_SECRET=
# infrastructure: OAuth refresh token for Google Drive.
GOOGLE_REFRESH_TOKEN=
# deployment configuration: the Drive folder that receives uploads.
MERIDIAN_DRIVE_FOLDER_ID=

# TypeSafe JEV is the decision transport. Its key is saved per workspace in Setup. Set JEV_SHARED_DEFAULT to use the deployment key.
# per-workspace key: the TypeSafe JEV key. The deployment fallback is used only when JEV_SHARED_DEFAULT=deployment.
TYPESAFE_JEV_API_KEY=
# deployment configuration: opt-in for the deployment's TypeSafe key. Set to "deployment" to use it.
JEV_SHARED_DEFAULT=
# deployment configuration: the TypeSafe endpoint.
TYPESAFE_JEV_BASE_URL=https://api.typesafe.ai/v1/systemone
# deployment configuration: the TypeSafe model.
TYPESAFE_JEV_MODEL=typesafe/jev-1.13
# deployment configuration: request timeout for a JEV decision, in milliseconds.
MERIDIAN_JEV_TIMEOUT_MS=30000
# per-workspace key: legacy alias of TYPESAFE_JEV_API_KEY, read as a deployment fallback.
# TYPESAFE_API_KEY=
# deployment configuration: legacy alias of TYPESAFE_JEV_BASE_URL.
# TYPESAFE_BASE_URL=
# deployment configuration: legacy alias of TYPESAFE_JEV_MODEL.
# TYPESAFE_MODEL=

# OpenAI Decisions is a second decision engine. Its key is saved per workspace in Setup. It runs only when it is the chosen engine.
# per-workspace key: the OpenAI key. The deployment fallback is used only when OPENAI_SHARED_DEFAULT=deployment.
OPENAI_API_KEY=
# deployment configuration: opt-in for the deployment's OpenAI key. Set to "deployment" to use it.
OPENAI_SHARED_DEFAULT=
# deployment configuration: the OpenAI Decisions model.
OPENAI_DECISIONS_MODEL=gpt-6-luna
# deployment configuration: request timeout in milliseconds.
OPENAI_DECISIONS_TIMEOUT_MS=60000
# deployment configuration: retries after a failed request.
OPENAI_DECISIONS_MAX_RETRIES=1
# deployment configuration: the OpenAI API origin.
OPENAI_BASE_URL=

# Gemini: one key serves perception (images and sampled video frames) and production (Omni video, image). Saved per workspace in Setup.
# per-workspace key: the Gemini key. The deployment fallback is used only when PERCEPTION_SHARED_DEFAULT or PRODUCTION_SHARED_DEFAULT opts in.
MERIDIAN_GEMINI_API_KEY=
# per-workspace key: documented alias of MERIDIAN_GEMINI_API_KEY, read by the Gemini key chain (config/resolver.ts). It is not a YouTube key.
# GOOGLE_AI_STUDIO_API_KEY=
# per-workspace key: documented alias of MERIDIAN_GEMINI_API_KEY.
# GEMINI_API_KEY=
# per-workspace key: documented alias of MERIDIAN_GEMINI_API_KEY.
# GOOGLE_API_KEY=
# deployment configuration: opt-in for the deployment's Gemini key as the perception key. Set to "gemini" to use it.
PERCEPTION_SHARED_DEFAULT=
# deployment configuration: opt-in for the deployment's Gemini key and the deployment's Higgsfield key. Set to "deployment" to use them.
PRODUCTION_SHARED_DEFAULT=
# deployment configuration: perception provider. Blank or "gemini" uses Gemini. "none" turns perception off. Any other value turns perception off too, and the reason is shown.
PERCEPTION_PROVIDER=
# deployment configuration: the Gemini model perception calls.
PERCEPTION_MODEL=gemini-2.5-flash
# deployment configuration: the Gemini Omni video model.
MERIDIAN_GEMINI_OMNI_MODEL=gemini-omni-1.1-flash
# deployment configuration: legacy alias of MERIDIAN_GEMINI_OMNI_MODEL.
# MERIDIAN_OMNI_MODEL=
# deployment configuration: the Gemini image model.
MERIDIAN_IMAGE_MODEL=gemini-nano-banana-2.1
# deployment configuration: image model override read by the Nano Banana provider.
# GOOGLE_NANO_BANANA_MODEL=
# deployment configuration: Higgsfield API key. Used only when PRODUCTION_SHARED_DEFAULT=deployment is set.
HIGGSFIELD_API_KEY=
# deployment configuration: the Higgsfield model.
HIGGSFIELD_MODEL=

# Hypit is a separate process. Install it yourself. Do not copy its source into this repository.
# deployment configuration: the Hypit runtime address. Without it Hypit stays not-configured.
HYPIT_BASE_URL=
# per-workspace key: the Hypit token. The deployment fallback is used only when HYPIT_SHARED_DEFAULT=deployment.
HYPIT_API_TOKEN=
# deployment configuration: opt-in for the deployment's Hypit token. Set to "deployment" to use it.
HYPIT_SHARED_DEFAULT=
# per-workspace key: the Apify token that runs the Instagram volume actors (Factory Gather). The deployment fallback is used only when APIFY_SHARED_DEFAULT=deployment.
APIFY_TOKEN=
# deployment configuration: opt-in for the deployment's Apify token. Set to "deployment" to use it.
APIFY_SHARED_DEFAULT=
# deployment configuration: the base URL of the ffmpeg media functions (a stateless serverless host). Unset, probe, frames and the other media checks stay NOT_CONNECTED. Restrict the host before setting it: the functions carry no credential.
MEDIA_FUNCTIONS_BASE_URL=
# deployment configuration: where the media functions run. "in_process" runs the ffmpeg handlers in the worker's own process (the image installs ffmpeg), and needs no base URL. Unset or "http" calls MEDIA_FUNCTIONS_BASE_URL. Any other value is a config error when the engine runs.
MEDIA_FUNCTIONS_MODE=
# per-workspace key: legacy alias of HYPIT_API_TOKEN.
# HYPIT_API_KEY=
# deployment configuration: the Hypit command the bridge starts.
HYPIT_BIN=
# deployment configuration: the port the Hypit bridge listens on.
HYPIT_BRIDGE_PORT=
# deployment configuration: the ffmpeg binary the Hypit bridge uses.
HYPIT_FFMPEG=
# deployment configuration: the ffprobe binary the Hypit bridge uses.
HYPIT_FFPROBE=
# deployment configuration: the folder the Hypit bridge keeps job files in.
HYPIT_JOB_ROOT=

# Local media and transcription tools. Each has a default, so leave them unset unless the tool lives elsewhere.
# deployment configuration: path to ffmpeg.
FFMPEG_PATH=ffmpeg
# deployment configuration: path to ffprobe.
FFPROBE_PATH=ffprobe
# deployment configuration: path to the WhisperX executable.
WHISPERX_PATH=whisperx
# deployment configuration: the WhisperX model size.
WHISPERX_MODEL=small
# deployment configuration: the device WhisperX runs on. cpu is the default.
WHISPERX_DEVICE=cpu
# deployment configuration: where the local embedding model is cached.
HF_HOME=

# Embeddings: the local model is used when these are blank. Only the key is a secret.
# deployment configuration: the external embeddings endpoint.
EXTERNAL_SEMANTIC_URL=
# infrastructure: the external embeddings key.
EXTERNAL_SEMANTIC_KEY=
# deployment configuration: the external embeddings model.
EXTERNAL_SEMANTIC_MODEL=
# deployment configuration: the vector size the external model returns.
EXTERNAL_SEMANTIC_DIMENSIONS=

# Research: caps and opt-ins for ad collection.
# deployment configuration: ads per collection run that reach the expensive steps. Blank uses the default.
RESEARCH_GATE_MAX_ADS=
# deployment configuration: "1" downloads snapshot video. Off by default.
RESEARCH_SNAPSHOT_MEDIA=

# Sources: each connector reads its own key. Save it per workspace in Setup, or set the deployment key and opt in.
# per-workspace key: the Meta Ad Library token. The deployment fallback is used only when META_AD_LIBRARY_SHARED_DEFAULT=deployment.
META_AD_LIBRARY_TOKEN=
# deployment configuration: opt-in for the deployment's Meta Ad Library token. Set to "deployment" to use it.
META_AD_LIBRARY_SHARED_DEFAULT=
# per-workspace key: the Meta Graph token for first-party analytics. Publishing and performance also read it directly.
META_ACCESS_TOKEN=
# per-workspace key: alias of META_ACCESS_TOKEN for the Meta Graph source.
# FACEBOOK_ACCESS_TOKEN=
# deployment configuration: opt-in for the deployment's Meta Graph token. Set to "deployment" to use it.
META_GRAPH_SHARED_DEFAULT=
# deployment configuration: the Meta app id for OAuth.
META_APP_ID=
# infrastructure: the Meta app secret for OAuth.
META_APP_SECRET=
# per-workspace key: the Instagram access token for the Instagram source.
INSTAGRAM_ACCESS_TOKEN=
# deployment configuration: opt-in for the deployment's Instagram token. Set to "deployment" to use it.
INSTAGRAM_SHARED_DEFAULT=
# per-workspace key: the YouTube API key for the YouTube source.
YOUTUBE_API_KEY=
# deployment configuration: opt-in for the deployment's YouTube key. Set to "deployment" to use it.
YOUTUBE_SHARED_DEFAULT=
# per-workspace key: the search API key (SerpAPI) for the search source.
SERPAPI_API_KEY=
# deployment configuration: opt-in for the deployment's search key. Set to "deployment" to use it.
SEARCH_SHARED_DEFAULT=
# per-workspace key: the X (Twitter) bearer token for the X source.
TWITTER_BEARER_TOKEN=
# per-workspace key: alias of the X bearer token, read as a fallback.
X_API_KEY=
# deployment configuration: opt-in for the deployment's X token. Set to "deployment" to use it.
TWITTER_SHARED_DEFAULT=
# per-workspace key: the LinkedIn access token for the LinkedIn source.
LINKEDIN_ACCESS_TOKEN=
# deployment configuration: opt-in for the deployment's LinkedIn token. Set to "deployment" to use it.
LINKEDIN_SHARED_DEFAULT=
# per-workspace key: the Pinterest access token for the Pinterest source.
PINTEREST_ACCESS_TOKEN=
# deployment configuration: opt-in for the deployment's Pinterest token. Set to "deployment" to use it.
PINTEREST_SHARED_DEFAULT=
# per-workspace key: the TikTok access token for the TikTok source. Publishing and performance also read it directly.
TIKTOK_ACCESS_TOKEN=
# deployment configuration: opt-in for the deployment's TikTok token. Set to "deployment" to use it.
TIKTOK_SHARED_DEFAULT=
# per-workspace key: the licensed ad-intelligence key (Sensor Tower or licensed data).
LICENSED_DATA_API_KEY=
# per-workspace key: the Sensor Tower key. The factory source also reads it directly.
SENSOR_TOWER_API_KEY=
# deployment configuration: the licensed ad-intelligence key that the factory source reads directly, not through the resolver.
LICENSED_AD_INTELLIGENCE_KEY=
# deployment configuration: opt-in for the deployment's licensed-data keys. Set to "deployment" to use them.
LICENSED_SHARED_DEFAULT=
# per-workspace key: the Shopify app's client secret. It verifies the orders/create webhook (X-Shopify-Hmac-Sha256). Saved in Settings.
# The Shopify row in Settings is the workspace's own entry; the deployment variable below is used only with the opt-in.
# deployment configuration: the deployment's Shopify app client secret, shared with every workspace. Used only when SHOPIFY_SHARED_DEFAULT=deployment.
SHOPIFY_WEBHOOK_SECRET=
# deployment configuration: opt-in for the deployment's Shopify secret. Set to "deployment" to use it.
SHOPIFY_SHARED_DEFAULT=

# Publishing, performance and OAuth connections. These are deployment settings read directly by the publishing code.
# deployment configuration: the TikTok app id for OAuth.
TIKTOK_APP_ID=
# infrastructure: the TikTok app secret for OAuth.
TIKTOK_APP_SECRET=
# deployment configuration: the Google Ads OAuth client id.
GOOGLE_ADS_CLIENT_ID=
# infrastructure: the Google Ads OAuth client secret.
GOOGLE_ADS_CLIENT_SECRET=
# infrastructure: the Google Ads developer token. Used only when GOOGLE_ADS_DEVELOPER_TOKEN_SHARED_DEFAULT=deployment is set.
GOOGLE_ADS_DEVELOPER_TOKEN=
# deployment configuration: opt-in for the deployment's Google Ads developer token. Set to "deployment" to use it.
GOOGLE_ADS_DEVELOPER_TOKEN_SHARED_DEFAULT=

# Cyclone Scout: a read-only observation gateway. A workspace can set its gateway in Settings. These are the deployment defaults.
# deployment configuration: the Cyclone gateway address.
CYCLONE_GATEWAY_URL=http://127.0.0.1:4000
# deployment configuration: the Cyclone gateway key.
CYCLONE_API_KEY=
# deployment configuration: the Cyclone device to observe.
CYCLONE_DEVICE_ID=
# deployment configuration: the observation budget per run.
CYCLONE_OBSERVATION_BUDGET=20

# OpenRouter: the chat path reads only the deployment key. The video engine reads each workspace's own OpenRouter key,
# saved in Setup, and the deployment key only for a workspace with none, under the same opt-in.
# deployment configuration: the OpenRouter key. Used only when OPENROUTER_SHARED_DEFAULT=deployment is set.
OPENROUTER_API_KEY=
# deployment configuration: opt-in for the deployment's OpenRouter key. Set to "deployment" to use it.
OPENROUTER_SHARED_DEFAULT=
# deployment configuration: the OpenRouter chat model.
OPENROUTER_MODEL=

# HeyGen and Anthropic keys for the video engine. Each is saved per workspace in Setup.
# per-workspace key: the HeyGen key. The deployment fallback is used only when HEYGEN_SHARED_DEFAULT=deployment.
HEYGEN_API_KEY=
# deployment configuration: opt-in for the deployment's HeyGen key. Set to "deployment" to use it.
HEYGEN_SHARED_DEFAULT=
# per-workspace key: the Anthropic key. The deployment fallback is used only when ANTHROPIC_SHARED_DEFAULT=deployment.
ANTHROPIC_API_KEY=
# deployment configuration: opt-in for the deployment's Anthropic key. Set to "deployment" to use it.
ANTHROPIC_SHARED_DEFAULT=
# per-workspace key: the Deepgram key for speech-to-text (word timings and the bill). The deployment fallback is used only when DEEPGRAM_SHARED_DEFAULT=deployment.
DEEPGRAM_API_KEY=
# deployment configuration: opt-in for the deployment's Deepgram key. Set to "deployment" to use it.
DEEPGRAM_SHARED_DEFAULT=

# Developer tooling: read by the scripts in scripts/ and by the tests. The app does not need these.
# developer tooling: the local PGlite data folder. Blank uses .data/pglite.
PGLITE_DATA=
# developer tooling: the local PGlite server port. Blank uses 54329.
PGLITE_PORT=
# developer tooling: the base URL that `npm run e2e` opens.
PRODUCT_BASE_URL=
# developer tooling: the folder the end-to-end run writes its artifacts to.
E2E_ARTIFACT_DIR=
# developer tooling: a Chromium binary for the browser checks, when Playwright's own download is not installed. Blank uses Playwright's.
MERIDIAN_SMOKE_CHROMIUM=
# developer tooling: the base URL the Content Factory browser flow opens. Blank uses http://localhost:8080.
MERIDIAN_SMOKE_URL=
# developer tooling: the account the Content Factory browser flow signs in with. Never committed.
MERIDIAN_SMOKE_EMAIL=
# developer tooling: the password of that account. Never committed.
MERIDIAN_SMOKE_PASSWORD=
# developer tooling: the folder the Content Factory browser flow writes its screenshots to. It must be under test-results.
MERIDIAN_SMOKE_OUT=
# developer tooling: the base URL the accessibility audit opens.
A11Y_BASE_URL=
# developer tooling: the browser smoke check's output folder.
BROWSER_SMOKE_OUTPUT_ROOT=
# developer tooling: the browser smoke check's timeout per page, in milliseconds.
BROWSER_SMOKE_TIMEOUT_MS=
# developer tooling: the browser smoke check's baseline file.
BROWSER_SMOKE_BASELINE=
# developer tooling: "1" lets the browser checks open a host that is not local.
BROWSER_ALLOW_EXTERNAL_HOST=
# developer tooling: the folder for design system screenshots, under the output root.
DESIGN_SMOKE_DIR=
# developer tooling: the root the design smoke output must stay under. Blank uses the working folder.
DESIGN_SMOKE_OUTPUT_ROOT=
# developer tooling: the preview thumbnail timeout, in milliseconds.
PREVIEW_THUMBNAIL_TIMEOUT_MS=
# developer tooling: the UI baseline capture's base URL.
UI_BASELINE_URL=
# developer tooling: the routes the UI baseline visits, comma separated.
UI_BASELINE_ROUTES=
# developer tooling: only capture the routes in this comma-separated filter.
UI_BASELINE_CAPTURE_ROUTES=
# developer tooling: the UI baseline's working folder.
UI_BASELINE_DIR=
# developer tooling: the UI baseline's output folder.
UI_BASELINE_OUTPUT_ROOT=
# developer tooling: the account the UI baseline signs in with.
UI_BASELINE_EMAIL=
# developer tooling: the password for the UI baseline account.
UI_BASELINE_PASSWORD=
# developer tooling: the name of the UI baseline run.
UI_BASELINE_NAME=

# deployment configuration: the optional sourcing sidecar (sidecar/sourcing) parses public pages with the vendored Scrapling parser.
# Leave both variables unset to use the built-in text extraction. The sidecar listens on 127.0.0.1 only.
# deployment configuration: the local sidecar address, plain http on 127.0.0.1 or localhost.
# MERIDIAN_SOURCING_SIDECAR_URL=http://127.0.0.1:8765
# deployment configuration: the sidecar token, at least 24 characters. Keep it out of the repository.
# MERIDIAN_SIDECAR_TOKEN=
# deployment configuration: providers whose outputs are licensed for commercial social use, comma-separated (unset: only reviewer clips pass).
ENGINE_LICENSED_PROVIDERS=
