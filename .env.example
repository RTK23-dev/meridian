# Copy to .env and fill only the values you have.
# Meridian stays not-connected for anything left blank. It does not invent ads, clips, or metrics.
# Never commit .env.

# Required for a durable database. See docs/SETUP.md for the local Postgres options.
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/meridian

# Public origin used for auth cookies and invite links.
BETTER_AUTH_URL=http://127.0.0.1:8080
BETTER_AUTH_SECRET=

# Image and video generation. Without this, Studio reports the model as unavailable.
XAI_API_KEY=

# Optional OpenAI-compatible chat or embedding fallback.
OPENROUTER_API_KEY=

# Optional external embeddings. Local MiniLM is used when these are blank.
EXTERNAL_SEMANTIC_URL=
EXTERNAL_SEMANTIC_KEY=
EXTERNAL_SEMANTIC_MODEL=
EXTERNAL_SEMANTIC_DIMENSIONS=

# Invite email. Without both, invitations are stored and not sent.
EMAIL_API_URL=
EMAIL_API_KEY=

# Object storage. Without these, files stay on the filesystem provider.
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=

# Token storage and webhooks. Required before OAuth tokens or webhook posts are accepted.
TOKEN_ENCRYPTION_KEY=
WEBHOOK_SECRET=

# Meta
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=
META_APP_ID=
META_APP_SECRET=
META_AD_LIBRARY_TOKEN=

# TikTok
TIKTOK_ACCESS_TOKEN=
TIKTOK_ADVERTISER_ID=
TIKTOK_APP_ID=
TIKTOK_APP_SECRET=

# Google Ads
GOOGLE_ADS_ACCESS_TOKEN=
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
