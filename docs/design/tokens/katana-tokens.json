{
  "name": "Katana",
  "status": "draft for owner review; not imported by the app yet",
  "note": "Colour roles only in themes. Keys match the CSS custom properties in docs/design/KATANA_DESIGN_PLAN.md section l, without the leading --. Dark is the default theme; light applies under [data-theme=\"light\"].",
  "themes": {
    "dark": {
      "bg-base": "#000000",
      "bg-raised": "#0E0E0E",
      "bg-overlay": "#161616",
      "border-hairline": "#262626",
      "border-strong": "#6B6B6B",
      "fg-primary": "#FFFFFF",
      "fg-secondary": "#C4C4C4",
      "fg-muted": "#949494",
      "accent-red": "#FF2E38",
      "accent-red-hover": "#FF5A63",
      "accent-red-muted": "#2A0B0F",
      "white-accent": "#FFFFFF",
      "success": "#3DDC84",
      "warning": "#FFB020",
      "danger": "#FF4D6A",
      "info": "#5AA9FF"
    },
    "light": {
      "bg-base": "#FFFFFF",
      "bg-raised": "#F4F4F4",
      "bg-overlay": "#FFFFFF",
      "border-hairline": "#E2E2E2",
      "border-strong": "#767676",
      "fg-primary": "#0A0A0A",
      "fg-secondary": "#3D3D3D",
      "fg-muted": "#5E5E5E",
      "accent-red": "#C8102E",
      "accent-red-hover": "#A50D25",
      "accent-red-muted": "#FBE3E6",
      "white-accent": "#0A0A0A",
      "success": "#14703A",
      "warning": "#8A5A00",
      "danger": "#B3133A",
      "info": "#0B5FB8"
    }
  },
  "shared": {
    "font-display": "\"Archivo\", \"Helvetica Neue\", Arial, sans-serif",
    "font-text": "\"Instrument Sans\", \"Segoe UI\", system-ui, sans-serif",
    "font-mono": "\"JetBrains Mono\", ui-monospace, \"SFMono-Regular\", Menlo, Consolas, monospace",
    "radius-sharp": "2px",
    "space-1": "4px",
    "space-2": "8px",
    "space-3": "12px",
    "space-4": "16px",
    "space-5": "20px",
    "space-6": "24px",
    "space-8": "32px",
    "space-10": "40px",
    "space-12": "48px",
    "space-16": "64px",
    "space-20": "80px",
    "space-24": "96px",
    "dur-fast": "120ms",
    "dur-base": "200ms",
    "dur-slow": "360ms",
    "dur-flip": "600ms",
    "ease-standard": "cubic-bezier(0.2, 0, 0, 1)",
    "ease-exit": "cubic-bezier(0.4, 0, 1, 1)",
    "ease-emphasis": "cubic-bezier(0.65, 0, 0.35, 1)",
    "ease-linear": "linear"
  },
  "contrast": [
    { "fg": "fg-primary", "bg": "bg-base", "min": 4.5 },
    { "fg": "fg-primary", "bg": "bg-raised", "min": 4.5 },
    { "fg": "fg-primary", "bg": "bg-overlay", "min": 4.5 },
    { "fg": "fg-secondary", "bg": "bg-base", "min": 4.5 },
    { "fg": "fg-secondary", "bg": "bg-raised", "min": 4.5 },
    { "fg": "fg-secondary", "bg": "bg-overlay", "min": 4.5 },
    { "fg": "fg-muted", "bg": "bg-base", "min": 4.5 },
    { "fg": "fg-muted", "bg": "bg-raised", "min": 4.5 },
    { "fg": "fg-muted", "bg": "bg-overlay", "min": 4.5 },
    { "fg": "accent-red", "bg": "bg-base", "min": 4.5 },
    { "fg": "accent-red", "bg": "bg-raised", "min": 4.5 },
    { "fg": "accent-red", "bg": "bg-overlay", "min": 4.5 },
    { "fg": "accent-red-hover", "bg": "bg-base", "min": 4.5 },
    { "fg": "bg-base", "bg": "accent-red", "min": 4.5 },
    { "fg": "bg-base", "bg": "accent-red-hover", "min": 4.5 },
    { "fg": "fg-primary", "bg": "accent-red-muted", "min": 4.5 },
    { "fg": "bg-base", "bg": "white-accent", "min": 4.5 },
    { "fg": "success", "bg": "bg-base", "min": 4.5 },
    { "fg": "success", "bg": "bg-raised", "min": 4.5 },
    { "fg": "warning", "bg": "bg-base", "min": 4.5 },
    { "fg": "warning", "bg": "bg-raised", "min": 4.5 },
    { "fg": "danger", "bg": "bg-base", "min": 4.5 },
    { "fg": "danger", "bg": "bg-raised", "min": 4.5 },
    { "fg": "info", "bg": "bg-base", "min": 4.5 },
    { "fg": "info", "bg": "bg-raised", "min": 4.5 },
    { "fg": "border-strong", "bg": "bg-base", "min": 3 },
    { "fg": "border-strong", "bg": "bg-raised", "min": 3 },
    { "fg": "accent-red", "bg": "bg-base", "min": 3, "use": "focus ring and graphics" },
    { "fg": "white-accent", "bg": "bg-base", "min": 3, "use": "graphics" },
    { "fg": "danger", "bg": "bg-base", "min": 3, "use": "icons" }
  ]
}
