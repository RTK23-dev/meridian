{
  "name": "Katana",
  "status": "selectable in Settings (Appearance) as an alternate style; AttentionOS stays the default. The app reads these values from src/styles.css, and src/styles.design.test.ts checks the two files agree",
  "source": "Katana design plan, docs/design/KATANA_DESIGN_PLAN.md. The values are those of release f248884d, renamed to the role keys AttentionOS uses.",
  "note": "Colour roles only in themes. Keys match the CSS custom properties in src/styles.css, without the leading --. Dark is the default theme of this style; light applies under [data-theme=\"light\"], and this style applies under [data-design=\"katana\"]. accent is a fill (buttons, the attention signal); accent-text is the same colour for text. on-accent is the text on an accent fill: the base colour of the theme.",
  "themes": {
    "dark": {
      "bg-base": "#000000",
      "bg-raised": "#0E0E0E",
      "bg-overlay": "#161616",
      "border-hairline": "#262626",
      "border-strong": "#6B6B6B",
      "fg-primary": "#FFFFFF",
      "fg-secondary": "#C4C4C4",
      "fg-muted": "#949494",
      "accent": "#FF2E38",
      "accent-hover": "#FF5A63",
      "accent-text": "#FF2E38",
      "accent-muted": "#2A0B0F",
      "on-accent": "#000000",
      "white-accent": "#FFFFFF",
      "success": "#3DDC84",
      "warning": "#FFB020",
      "danger": "#FF4D6A",
      "info": "#5AA9FF"
    },
    "light": {
      "bg-base": "#FFFFFF",
      "bg-raised": "#F4F4F4",
      "bg-overlay": "#FFFFFF",
      "border-hairline": "#E2E2E2",
      "border-strong": "#767676",
      "fg-primary": "#0A0A0A",
      "fg-secondary": "#3D3D3D",
      "fg-muted": "#5E5E5E",
      "accent": "#C8102E",
      "accent-hover": "#A50D25",
      "accent-text": "#C8102E",
      "accent-muted": "#FBE3E6",
      "on-accent": "#FFFFFF",
      "white-accent": "#0A0A0A",
      "success": "#14703A",
      "warning": "#8A5A00",
      "danger": "#B3133A",
      "info": "#0B5FB8"
    }
  },
  "shared": {
    "font-display": "\"Archivo Variable\", \"Archivo\", \"Helvetica Neue\", Arial, sans-serif",
    "font-wordmark": "\"Archivo Variable\", \"Archivo\", \"Helvetica Neue\", Arial, sans-serif",
    "font-text": "\"Instrument Sans Variable\", \"Instrument Sans\", \"Segoe UI\", system-ui, sans-serif",
    "font-mono": "\"JetBrains Mono\", ui-monospace, \"SFMono-Regular\", Menlo, Consolas, monospace",
    "radius-sharp": "2px",
    "radius-sm": "2px",
    "radius-md": "2px",
    "radius-lg": "2px",
    "radius-xl": "2px",
    "text-eyebrow": "0.6875rem",
    "text-body--line-height": "1.375rem",
    "dur-fast": "120ms",
    "dur-base": "200ms",
    "dur-slow": "360ms",
    "dur-flip": "900ms",
    "ease-standard": "cubic-bezier(0.2, 0, 0, 1)",
    "ease-exit": "cubic-bezier(0.4, 0, 1, 1)",
    "ease-signal": "cubic-bezier(0.16, 1, 0.3, 1)",
    "ease-linear": "linear"
  },
  "contrast": [
    { "fg": "fg-primary", "bg": "bg-base", "min": 4.5 },
    { "fg": "fg-primary", "bg": "bg-raised", "min": 4.5 },
    { "fg": "fg-primary", "bg": "bg-overlay", "min": 4.5 },
    { "fg": "fg-secondary", "bg": "bg-base", "min": 4.5 },
    { "fg": "fg-secondary", "bg": "bg-raised", "min": 4.5 },
    { "fg": "fg-secondary", "bg": "bg-overlay", "min": 4.5 },
    { "fg": "fg-muted", "bg": "bg-base", "min": 4.5 },
    { "fg": "fg-muted", "bg": "bg-raised", "min": 4.5 },
    { "fg": "fg-muted", "bg": "bg-overlay", "min": 4.5 },
    { "fg": "accent-text", "bg": "bg-base", "min": 4.5 },
    { "fg": "accent-text", "bg": "bg-raised", "min": 4.5 },
    { "fg": "accent-text", "bg": "bg-overlay", "min": 4.5 },
    { "fg": "on-accent", "bg": "accent", "min": 4.5 },
    { "fg": "on-accent", "bg": "accent-hover", "min": 4.5 },
    { "fg": "fg-primary", "bg": "accent-muted", "min": 4.5 },
    { "fg": "success", "bg": "bg-base", "min": 4.5 },
    { "fg": "success", "bg": "bg-raised", "min": 4.5 },
    { "fg": "warning", "bg": "bg-base", "min": 4.5 },
    { "fg": "warning", "bg": "bg-raised", "min": 4.5 },
    { "fg": "danger", "bg": "bg-base", "min": 4.5 },
    { "fg": "danger", "bg": "bg-raised", "min": 4.5 },
    { "fg": "info", "bg": "bg-base", "min": 4.5 },
    { "fg": "info", "bg": "bg-raised", "min": 4.5 },
    { "fg": "border-strong", "bg": "bg-base", "min": 3 },
    { "fg": "border-strong", "bg": "bg-raised", "min": 3 },
    { "fg": "accent", "bg": "bg-base", "min": 3 },
    { "fg": "white-accent", "bg": "bg-base", "min": 3 },
    { "fg": "danger", "bg": "bg-base", "min": 3 }
  ]
}
