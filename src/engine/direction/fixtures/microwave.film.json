  "claims": [
    {
      "text": "Home microwave ovens run at 2,450 MHz: the field swings back and forth 2,450,000,000 (2.45 billion) times a second.",
      "source": "US FDA, Microwave Ovens (radiation-emitting products); HyperPhysics, Microwave Ovens",
      "url": "https://hyperphysics.gsu.edu/hbase/waves/mwoven.html"
    },
    {
      "text": "Water molecules are polar (one end slightly positive, the other negative); the oscillating field turns them, and the jostling heats the food (dielectric heating, a simplified picture).",
      "source": "HyperPhysics, Microwave Ovens"
    },
    {
      "text": "Microwave ovens heat unevenly and leave cold spots; stir or rotate food midway so the heat reaches the centre.",
      "source": "USDA FSIS, Cooking Safely in the Microwave Oven"
    }
  ],
